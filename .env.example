# ==============================================================================
# Environment Configuration Template
# Copy this file to .env or .env.local and update with your own values.
# ==============================================================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Public master-sheet shortcut. This URL does not grant write access.
VITE_GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/1fcChOwOccK8txqtFNDIa6JxA79l9nrHm1juXLQHBK_k/edit
# Keep false until the server worker, secrets, and scheduled job are deployed.
VITE_GOOGLE_SHEETS_SYNC_ENABLED=false

# Edge Function secrets: set these in the server environment, never as VITE_*.
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are supplied
# by the Supabase function runtime. Configure an exact origin allowlist:
# SUPPORT_HUB_ALLOWED_ORIGINS=https://support.example.com
# Deploy complete-password-change after the reviewed database controls.
# Google Sheets secrets are GOOGLE_SHEETS_WEBAPP_URL, GOOGLE_SHEETS_SECRET_TOKEN,
# and GOOGLE_SHEETS_WORKER_SECRET. Do not add them to this browser environment file.

# Helpdesk / Ticketing Integration (Optional)
# Template URL for chat tickets. Supports an optional {id} placeholder or trailing slash.
# Example: https://support.example.com/tickets/{id}
VITE_HELPDESK_TICKET_URL=

# Display name for the ticketing service in UI badges and placeholders (Default: "Ticket")
# Example: Helpdesk
VITE_HELPDESK_NAME=
