# ==============================================================================
# Environment Configuration Template
# Copy this file to .env or .env.local and update with your own values.
# ==============================================================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Sheets Synchronization (Optional)
VITE_GOOGLE_SHEETS_URL=
VITE_GOOGLE_SHEETS_WEBAPP_URL=

# Google Sheets Authentication Token (Recommended)
# A shared secret appended as ?token=... to every sync request so your
# Apps Script doPost() handler can reject unauthorized writes.
# Generate a strong random value (e.g. `openssl rand -hex 32`) and set the
# same value in your Apps Script project properties / doPost() validation.
VITE_GOOGLE_SHEETS_SECRET_TOKEN=

# Helpdesk / Ticketing Integration (Optional)
# Template URL for chat tickets. Supports an optional {id} placeholder or trailing slash.
# Example: https://support.example.com/tickets/{id}
VITE_HELPDESK_TICKET_URL=

# Display name for the ticketing service in UI badges and placeholders (Default: "Ticket")
# Example: Helpdesk
VITE_HELPDESK_NAME=
